generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  RESERVED
  CANCELLED
  EXPIRED
  PAID
  PAYMENT_REVIEW
  REFUNDED
}

enum MovementKind {
  INITIAL
  RESERVE
  RELEASE
  ADJUST
  SALE
}

model Product {
  collections Collection[]
  version     Int          @default(0)
  id          String       @id
  slug        String       @unique
  name        String
  category    String
  description String
  image       String
  gallery     String[]
  demo        Boolean      @default(true)
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  variants    Variant[]
}

model Variant {
  version    Int                 @default(0)
  id         String              @id
  productId  String
  product    Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku        String              @unique
  label      String
  price      Int
  stock      Int                 @default(0)
  reserved   Int                 @default(0)
  active     Boolean             @default(true)
  updatedAt  DateTime            @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([productId])
}

model VisitorSession {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  cartItems CartItem[]
  orders    Order[]
  customer  Customer?

  @@index([expiresAt])
}

model CartItem {
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  @@id([sessionId, variantId])
}

model Coupon {
  code       String   @id
  percent    Int
  minimum    Int      @default(0)
  usageLimit Int
  used       Int      @default(0)
  active     Boolean  @default(false)
  demo       Boolean  @default(true)
  expiresAt  DateTime
  orders     Order[]
}

model ShippingRate {
  version    Int @default(0)
  carrier    String @default("Transportadora de ejemplo")
  minDays    Int @default(2)
  maxDays    Int @default(5)
  id         String  @id
  department String
  city       String
  amount     Int
  active     Boolean @default(false)
  demo       Boolean @default(true)

  @@unique([department, city])
}

model Order {
  shippingCarrier String @default("Por definir")
  shippingEstimate String @default("Por definir")
  shippingStatus String @default("PENDING")
  trackingNumber String @default("")
  shippingEvents ShippingEvent[]
  payment        Payment?
  followUp       String              @default("PENDING")
  version        Int                 @default(0)
  id             String              @id @default(cuid())
  number         String              @unique
  sessionId      String
  session        VisitorSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  idempotencyKey String
  requestHash    String
  status         OrderStatus         @default(RESERVED)
  demo           Boolean             @default(true)
  subtotal       Int
  discount       Int
  shipping       Int
  total          Int
  currency       String              @default("COP")
  couponCode     String?
  coupon         Coupon?             @relation(fields: [couponCode], references: [code], onDelete: Restrict)
  recipient      Json
  shippingLabel  String
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          OrderItem[]
  movements      InventoryMovement[]

  @@unique([sessionId, idempotencyKey])
  @@index([demo, createdAt])
  @@index([status, expiresAt])
  @@index([sessionId, createdAt])
}

model ShippingEvent {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status String
  note String
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reference     String   @unique
  transactionId String?  @unique
  status        String   @default("CREATED")
  checkedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  refund        PaymentRefund?
}

model PaymentRefund {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  status     String   @default("REQUESTED")
  providerId String?
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName  String
  variantLabel String
  sku          String
  unitPrice    Int
  quantity     Int

  @@unique([orderId, variantId])
}

model InventoryMovement {
  id        String       @id @default(cuid())
  variantId String
  variant   Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind      MovementKind
  quantity  Int
  reason    String
  createdAt DateTime     @default(now())

  @@unique([orderId, variantId, kind])
  @@index([variantId, createdAt])
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum CustomerRole {
  CUSTOMER
  ADMIN
}

enum AccountTokenKind {
  VERIFY
  RESET
}

model Customer {
  audits        AdminAudit[]
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          CustomerRole   @default(CUSTOMER)
  active        Boolean        @default(true)
  verifiedAt    DateTime?
  cartSessionId String         @unique
  cartSession   VisitorSession @relation(fields: [cartSessionId], references: [id], onDelete: Restrict)
  sessions      AuthSession[]
  tokens        AccountToken[]
  addresses     Address[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  actor     Customer @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entityId  String
  before    Json
  after     Json
  reason    String
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([createdAt])
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model AccountToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  kind       AccountTokenKind
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([customerId, kind])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  recipient  String
  phone      String
  department String
  city       String
  street     String
  additional String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Collection {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String
  active      Boolean   @default(false)
  version     Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model MediaAsset {
  id        String   @id
  label     String
  width     Int
  height    Int
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
