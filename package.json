{
  "name": "sj-aurum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "effect": "3.22.1"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:local": "node scripts/local-db.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:integration": "tsx scripts/integration.ts",
    "test:http": "node scripts/http-smoke.mjs",
    "reservations:expire": "tsx scripts/release-expired.ts",
    "test:auth": "tsx scripts/auth-integration.ts",
    "test:auth-http": "node scripts/auth-http.mjs",
    "mail:local": "node scripts/local-mail.mjs",
    "admin:role": "tsx scripts/admin-role.ts",
    "test:admin": "tsx scripts/admin-integration.ts",
    "test:admin-http": "tsx scripts/admin-http.ts",
    "test:admin-orders": "tsx scripts/admin-orders-integration.ts",
    "test:admin-orders-http": "tsx scripts/admin-orders-http.ts",
    "test:catalog-media": "tsx scripts/catalog-media-integration.ts",
    "test:catalog-media-http": "tsx scripts/catalog-media-http.ts"
  },
  "dependencies": {
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "next": "^16.0.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.12.0-beta.19",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
